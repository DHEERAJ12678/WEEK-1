from sklearn.datasets import load_iris
from sklearn.cluster import KMeans
import matplotlib.pyplot as plt
import pandas as pd

# ------------------------------------------------------------
# 1. Load Iris Dataset
# ------------------------------------------------------------

iris = load_iris()

X = iris.data
y_true = iris.target

print("Dataset Shape:", X.shape)

# ------------------------------------------------------------
# 2. Apply K-Means (K = 3)
# ------------------------------------------------------------

kmeans = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

y_pred = kmeans.fit_predict(X)

# ------------------------------------------------------------
# 3. Print Cluster Centers
# ------------------------------------------------------------

print("\nCluster Centers:")
print(kmeans.cluster_centers_)

# ------------------------------------------------------------
# 4. Visualize Clusters
# ------------------------------------------------------------

plt.figure(figsize=(8, 6))

plt.scatter(
    X[:, 0],
    X[:, 1],
    c=y_pred,
    s=50
)

plt.scatter(
    kmeans.cluster_centers_[:, 0],
    kmeans.cluster_centers_[:, 1],
    marker='X',
    s=200,
    label="Cluster Centers"
)

plt.xlabel("Sepal Length")
plt.ylabel("Sepal Width")
plt.title("Iris Dataset - K-Means Clustering")
plt.legend()
plt.show()

# ------------------------------------------------------------
# 5. Compare Predicted Clusters with True Labels
# ------------------------------------------------------------

comparison = pd.DataFrame({
    "True Label": y_true,
    "Predicted Cluster": y_pred
})

print("\nTrue Labels vs Predicted Clusters:")
print(comparison.head(20))

# ------------------------------------------------------------
# 6. Create Comparison Table
# ------------------------------------------------------------

comparison_table = pd.crosstab(
    comparison["True Label"],
    comparison["Predicted Cluster"]
)

print("\nComparison Table:")
print(comparison_table)
