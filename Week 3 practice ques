# Q3: Apply PCA to reduce Iris dataset to 2D

from sklearn.datasets import load_iris
from sklearn.decomposition import PCA
import matplotlib.pyplot as plt

# Load Iris dataset
iris = load_iris()
X = iris.data

# Apply PCA
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)

# Print original and reduced shape
print("Original shape:", X.shape)
print("Reduced shape:", X_pca.shape)

# Display first 5 transformed values
print("\nFirst 5 PCA values:")
print(X_pca[:5])

# Visualize PCA result
plt.figure(figsize=(8, 6))

plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    s=50
)

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("Iris Dataset after PCA")
plt.show()




# Q4: Find Explained Variance Ratio

from sklearn.datasets import load_iris
from sklearn.decomposition import PCA

# Load Iris dataset
iris = load_iris()
X = iris.data

# Apply PCA
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)

# Get explained variance ratio
variance_ratio = pca.explained_variance_ratio_

print("Explained Variance Ratio:")
print(variance_ratio)

# Print individual components
print("\nPC1 explains:",
      variance_ratio[0] * 100, "% variance")

print("PC2 explains:",
      variance_ratio[1] * 100, "% variance")

# Total variance explained
total_variance = variance_ratio.sum()

print("\nTotal variance explained:",
      total_variance * 100, "%")
